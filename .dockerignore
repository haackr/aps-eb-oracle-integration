# VCS
.git
.gitignore

# Python cache/build artifacts
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
dist/
build/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Local env/secrets
.env
.env.*
!.env.example

# Editor/OS noise
.vscode/
.idea/
.DS_Store

# Terraform local state and plans
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfplan

# Logs and temp
*.log
tmp/
temp/
